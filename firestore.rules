rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global lock default
    match /{document=**} {
      allow read, write: if false;
    }

    // Role-Based Access Control Definitions
    function isSignedIn() { 
      return request.auth != null; 
    }
    // Conceptually, in production a custom claim or user doc is used:
    // function hasRole(requiredRole) { return request.auth.token.role == requiredRole; }
    
    // ---------------------------------------------------------
    // Core Schema (core.users, org_units, system)
    // ---------------------------------------------------------
    match /users/{userId} {
      // Users can read own profile, Admins can read all. (Bypassed for Dev/Demo)
      allow get, list, create, update, delete: if true;
    }
    match /org_units/{id} { allow read, write: if true; }
    match /user_roles/{id} { allow read, write: if true; }
    match /system_settings/{id} { allow read, write: if true; }

    // ---------------------------------------------------------
    // Finance & Ledger (chart_of_accounts, account_balances)
    // ---------------------------------------------------------
    match /accounts/{id} { allow read, write: if true; }
    match /journal_entries/{id} { allow read, write: if true; }
    match /audit_logs/{id} { allow read, write: if true; }

    // ---------------------------------------------------------
    // Human Resources (hr schema)
    // ---------------------------------------------------------
    match /attendance/{id} { allow read, write: if true; }
    match /attendance_logs/{id} { allow read, write: if true; }
    match /pay_runs/{id} { allow read, write: if true; }
    match /payslips/{id} { allow read, write: if true; }
    match /leave_requests/{id} { allow read, write: if true; }
    match /performance_reviews/{id} { allow read, write: if true; }
    match /retail_shifts/{id} { allow read, write: if true; }
    match /biometric_devices/{id} { allow read, write: if true; }
    match /candidate_applications/{id} { allow read, write: if true; }

    // ---------------------------------------------------------
    // Procurement & Supply Chain (procurement schema)
    // ---------------------------------------------------------
    match /suppliers/{id} { allow read, write: if true; } // New explicitly requested
    match /vendors/{id} { allow read, write: if true; }
    match /purchase_orders/{id} { allow read, write: if true; }
    match /bill_payments/{id} { allow read, write: if true; }
    match /inventory/{id} { allow read, write: if true; }
    match /warehouses/{id} { allow read, write: if true; }
    match /stock_movements/{id} { allow read, write: if true; }

    // ---------------------------------------------------------
    // Sales & Customers (sales schema)
    // ---------------------------------------------------------
    match /clients/{id} { allow read, write: if true; }
    match /customers/{id} { allow read, write: if true; }
    match /sales_orders/{id} { allow read, write: if true; }
    match /invoices/{id} { allow read, write: if true; }
    match /payments/{id} { allow read, write: if true; }
    match /crm_deals/{id} { allow read, write: if true; }
    match /leads/{id} { allow read, write: if true; }

    // ---------------------------------------------------------
    // Related Parties (Stakeholders, Partners)
    // ---------------------------------------------------------
    match /related_parties/{id} { allow read, write: if true; }
    match /partner_ledger/{id} { allow read, write: if true; }
    match /investors/{id} { allow read, write: if true; }
    match /director_loans/{id} { allow read, write: if true; }

    // ---------------------------------------------------------
    // Banking & Assets
    // ---------------------------------------------------------
    match /bank_accounts/{id} { allow read, write: if true; }
    match /bank_transactions/{id} { allow read, write: if true; }
    match /fixed_assets/{id} { allow read, write: if true; }
    match /depreciation_logs/{id} { allow read, write: if true; }

    // ---------------------------------------------------------
    // Operational & Support
    // ---------------------------------------------------------
    match /projects/{id} { allow read, write: if true; }
    match /support_tickets/{id} { allow read, write: if true; }
    match /maintenance_requests/{id} { allow read, write: if true; }
    match /qc_inspections/{id} { allow read, write: if true; }
    match /boms/{id} { allow read, write: if true; }

    // Legacy fallbacks for general dev iteration
    match /{document=**} {
      allow read, write: if true; // DEMO / DEV BYPASS
    }
  }
}
