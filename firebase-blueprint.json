{
  "entities": {
    "User": {
      "title": "User",
      "description": "System or client Employee profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "version": { "type": "number" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "isSetupComplete": { "type": "boolean" },
        "twoFaSecret": { "type": "string" }
      },
      "required": ["tenantId", "createdAt", "updatedAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer record for sales tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "version": { "type": "number" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "balance": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["tenantId", "createdAt", "updatedAt", "name"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Sales invoice record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "version": { "type": "number" },
        "invoiceNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "date": { "type": "string" },
        "dueDate": { "type": "string" },
        "status": { "type": "string" },
        "totalAmount": { "type": "number" }
      },
      "required": ["tenantId", "createdAt", "updatedAt", "invoiceNumber", "customerId"]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "Vendor record for supply chains",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "version": { "type": "number" },
        "name": { "type": "string" },
        "balance": { "type": "number" }
      },
      "required": ["tenantId", "createdAt", "updatedAt", "name"]
    },
    "Bill": {
      "title": "Bill",
      "description": "Supply chains billing record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "version": { "type": "number" },
        "billNumber": { "type": "string" },
        "vendorId": { "type": "string" },
        "totalAmount": { "type": "number" }
      },
      "required": ["tenantId", "createdAt", "updatedAt", "billNumber", "vendorId"]
    },
    "UserBentoLayout": {
      "title": "UserBentoLayout",
      "description": "Customized dashboard bento layout preferences for a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "widgets": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "widgets", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Users credentials and settings collection"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Collection of client customers"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Sales invoices collection"
    },
    "/vendors/{vendorId}": {
      "schema": "Vendor",
      "description": "Incoming raw materials suppliers"
    },
    "/bills/{billId}": {
      "schema": "Bill",
      "description": "Invoiced bills collection"
    },
    "/user_bento_layouts/{layoutId}": {
      "schema": "UserBentoLayout",
      "description": "User specific dashboard Bento grid config"
    }
  }
}
